# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="product-images"

# Neon PostgreSQL
# Pooled connection for the Netlify runtime.
DATABASE_URL="postgresql://[user]:[password]@[endpoint].pooler.neon.tech/[database]?sslmode=require&channel_binding=require"
# Unpooled/direct connection for Prisma migrations and local administration.
DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require&channel_binding=require"

# NextAuth session layer used by the existing admin UI
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://your-site.netlify.app"
NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"
NEXT_PUBLIC_MENU_URL="https://your-site.netlify.app"
STORAGE_PROVIDER="supabase"

# Local-only fallback when Supabase Auth is not configured
SEED_ADMIN_EMAIL="admin@spark.local"
SEED_ADMIN_PASSWORD="change-this-before-seeding"
